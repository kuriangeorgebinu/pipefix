// A trimmed-down nf-core-style pipeline used by Strandline's tests and demos
manifest {
    name            = 'demo/sarek-mini'
    nextflowVersion = '!>=24.04.2'
}

params {
    outdir     = 'results'
    max_memory = '128.GB'   // nf-core style cap
    max_cpus   = 16
    max_time   = '240.h'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = 'spot-queue'
        aws.region       = 'us-east-1'
    }
}
