process {
    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.args = { "--max-alternate-alleles 3" }
        publishDir = [ path: { "${params.outdir}/variant_calling" }, mode: 'copy' ]
    }
    withName: '.*:ALIGN_STAR:STAR_ALIGN' {
        ext.args = '--quantMode TranscriptomeSAM --twopassMode Basic'
    }
    withName: "MULTIQC" {
        container = '123456789012.dkr.ecr.us-east-1.amazonaws.com/multiqc:1.99'
    }
}
